{
  "name": "pi-compact-tools",
  "version": "0.2.0",
  "description": "Compact, collapsible built-in tool-call rendering for Pi Coding Agent.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "tool-renderer",
    "tui",
    "developer-tools"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test && npm run test:e2e && npm audit --audit-level=high && npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.4",
    "@earendil-works/pi-tui": "^0.84.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  },
  "pi": {
    "extensions": [
      "./extensions/compact-tools.ts"
    ]
  }
}
